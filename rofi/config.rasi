configuration {
    modi                :   "drun,filebrowser,calc,window";
    show-icons          :                            false;
    display-drun        :                           "Apps";
    display-filebrowser :                          "Files";
    display-calc        :                           "Calc";
    display-window      :                         "Window";
	drun-display-format :                         "{name}";
	window-format       :                   " {w}   {c}";
    filebrowser {
      directory        : "/home/$USER";
      sorting-method    :     "name";
      directories-first :       true;
      show-hidden       :       true;
      cancel-returns-1  :       true;
    }
}

* {
    window-background   :   #282A2ECC;

    glass-bg            :   rgba(136, 203, 218, 0.06);
    glass-bg-hover      :   rgba(39, 161, 185, 0.22);
    glass-border        :   rgba(136, 203, 218, 0.14);
    glass-border-bright :   rgba(39, 161, 185, 0.55);

    shaded-dark-two     :   #4C566A;
    neon-blue           :   #27A1B9;
    shaded-light        :   #FFFFFF;
    aurora-blue         :   #27A1B9;
    aurora-blue-light   :   #53C8E0;
    aurora-green        :   #53E8D4;
    nord-frost          :   #88C0D0;
    nord-bg             :   #4C566A;
    neon-red            :   #A54242;
    text-color          :   #C5C8C6;
}

window {
    background-color    :       @window-background;
    padding             :                       15;
    border-radius       :                       16;
    width               :                      25%;
    height              :                      60%;
    transparency        :                   "real";
    y-offset            :                       10;
    
    border              :                        1px;
    border-color        :            @glass-border;
}

mainbox {
    border              :                                                         0;
    padding             :                                                         0;
    children            :      ["inputbar", "message", "listview", "mode-switcher"];
    orientation         :                                                  vertical;
    spacing             :                                                         10;
    background-color    :                                              transparent;
}

message {
    border              :       0px;
    padding             :               1px;
}

textbox {
    text-color          :        @text-color;
}

listview {
    fixed-height        :                  0;
    spacing             :                5px;
    scrollbar           :              false;
    padding             :               10px;
    border-radius       :               10px;
    columns             :                  1;
    background-color    :        transparent;
}

element {
    border-radius       :                                 10px;
    padding             :                                  8px;
    padding-left        :                                 10px;
    orientation         :                           horizontal;
    margin-left         :                                  0px;
    children            :       [ element-icon, element-text ];
    spacing             :                                 10px;
    background-color    :                          transparent;
}

element-text {
    background-color    :         transparent;
    text-color          :             inherit;
}

element-icon {
    size : 0px;
}

element.normal.normal {
    background-color    :         transparent;
    text-color          :         @text-color;
}

element.normal.urgent {
    background-color    :    @shaded-dark-two;
    text-color          :         @text-color;
}

element.normal.active {
    text-color          :         @text-color;
}

element.selected.normal {
    background-color    :          @glass-bg-hover;
    text-color          :              #FFFFFF;
    border              :                  1px;
    border-color        : @glass-border-bright;
    border-radius       :                 10px;
}

element.selected.urgent {
    background-color    :           @neon-red;
    text-color          :         @text-color;
    border              :                   1;
    border-radius       :                20px;
}

element.selected.active {
    background-color    :          @neon-blue;
    text-color          :       @shaded-light;
    border              :                   1;
    border-radius       :                20px;
}

element.alternate.normal {
    background-color    :         transparent;
    text-color          :         @text-color;
}

element.alternate.urgent {
    background-color    :         transparent;
    text-color          :         @text-color;
}

element.alternate.active {
    background-color    :         transparent;
    text-color          :         @text-color;
}

scrollbar {
    width               :                 4px;
    border              :                   0;
    handle-color        :  @normal-foreground;
    handle-width        :                 8px;
    padding             :                   0;
}

mode-switcher {
    enabled             :                true;
    border              :                 0px;
    spacing             :                 5px;
}

button {
    padding             :                 8px;
    border-radius       :                10px;
    text-color          :         @text-color;
    background-color    :            @glass-bg;
    border              :                 1px;
    border-color        :        @glass-border;
}

button.selected {
    background-color    :      @glass-bg-hover;
    text-color          :             #FFFFFF;
    border-color        : @glass-border-bright;
}

inputbar {
    spacing             :                                                    0;
    text-color          :                                          @text-color;
    padding             :                                                  5px;
    background-color    :                                          transparent;
    margin              :                                                  5px;
    children            :   [prompt,textbox-prompt-colon,entry,case-indicator];
}

case-indicator {
    spacing             :                   0;
    text-color          :         @text-color;
}

entry {
    spacing             :                   0;
    background-color    :             @glass-bg;
    border              :                   1px;
    border-color        :         @glass-border;
    border-radius       :                  10px;
    padding             :                  10px;
    text-color          :               #FFFFFF;
    placeholder         :         "Search Apps";
    placeholder-color   :               #888888;
}

prompt {
    spacing             :                   0;
    text-color          :         @text-color;
    padding             :                 8px;
}

textbox-prompt-colon {
    padding             :                 8px;
    margin              :  0px 0.3em 0em 0em ;
    text-color          :         @text-color;
}